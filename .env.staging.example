# .env.staging — staging-стенд на том же сервере, что и прод (docker-compose.staging.yml,
# MESSENGER_MIGRATION.md, раздел A). Скопировать в .env.staging в КАТАЛОГЕ STAGING и заполнить.
# Пояснения к переменным — .env.example. Здесь — только отличия staging.
#
# НЕ копировать сюда .env.prod: все ключи внешних сервисов — тестовые/пустые, иначе staging на
# копии боевой базы шлёт SMS, пуши и вебхуки реальным людям и партнёрам.
# Никогда не копировать из прода LIVEKIT_API_KEY / LIVEKIT_API_SECRET / LIVEKIT_URL /
# LIVEKIT_API_URL: staging-backend управлял бы комнатами и звонками прод-LiveKit.
# Пустые значения — без комментария в той же строке (compose прочитал бы «KEY=  # x» как «# x»).

# Домен staging = STAGING_DOMAIN в .env.prod прода. DNS: staging., files./rtc./turn.staging. → IP сервера.
DOMAIN=staging.example.com
DJANGO_ALLOWED_HOSTS=staging.example.com
DEBUG=0
# свой, не прод: openssl rand -hex 32
SECRET_KEY=change-me

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=django_db
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=0

# staging-redis проекта profichat-staging (имя redis — внутри сети staging, не прод-Redis)
REDIS_URL=redis://redis:6379

# Сервисы, доступные прод-nginx, называются staging-* (docker-compose.staging.yml)
CENTRIFUGO_API_URL=http://staging-centrifugo:8000/api
CENTRIFUGO_API_KEY=change-me
CENTRIFUGO_TOKEN_SECRET=change-me
CENTRIFUGO_WS_URL=wss://staging.example.com/connection/websocket

S3_ENDPOINT_URL=http://staging-minio:9000
S3_PUBLIC_ENDPOINT_URL=https://files.staging.example.com
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-long-secret
S3_BUCKET=messenger
S3_REGION=us-east-1
# свой ключ: messenger-key:$(openssl rand -base64 32)
S3_KMS_SECRET_KEY=messenger-key:change-me-base64-32-bytes

# LiveKit staging — сеть хоста, порт 17880 (livekit/livekit.staging.yaml). Ключ/секрет — свои, не прод.
LIVEKIT_URL=wss://rtc.staging.example.com
LIVEKIT_API_URL=http://host.docker.internal:17880
LIVEKIT_WEBHOOK_URL=https://staging.example.com/api/messenger/livekit-webhook/
LIVEKIT_API_KEY=staging-change-me
LIVEKIT_API_SECRET=change-me-at-least-32-characters-long
LIVEKIT_TURN_DOMAIN=turn.staging.example.com

# Переходный режим выключен: staging проверяет новое приложение
MESSENGER_LEGACY_MODE=False

# GetStream — НЕ боевые ключи (отдельное приложение Stream или заглушка). Боевые передаются
# только команде импорта через `exec -e` (раздел A6/A7).
STREAM_API_KEY=change-me
STREAM_API_SECRET=change-me

# Внешние интеграции — тестовые или пустые
RAVEN_API_URL=https://raven.operator.kg/api/v1
RAVEN_API_KEY=test-or-stub
PAYMENT_API_TOKEN=test-mode-token
MEDCRM_API_KEY=
MEDCRM_SSO_WEB_URL=
MEDCRM_SSO_INTEGRATION_SECRET=
MAMADOC_API_URL=
MAMADOC_API_KEY=
SENTRY_DSN=
# отдельные тестовые боты: у токена Telegram один webhook, боевой токен перехватил бы webhook прода
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_WEBHOOK_SECRET=
TELEGRAM_ADMIN_WEBHOOK_SECRET=
TELEGRAM_ERROR_ALERTS_ENABLED=False

# VoIP-пуши iOS: песочница для сборок из Xcode
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=True
