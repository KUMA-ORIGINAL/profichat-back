DEBUG=1
SECRET_KEY=abc
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=django_db
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=0                 # В секундах; 0 = закрывать соединение после каждого запроса

GET_CERTS=False                          # True для получения сертификатов (обязательно укажите email в CERTBOT_EMAIL
CERTBOT_EMAIL=example@example.com        # Email для регистрации certbot
DOMAIN=exemple.com                       # Домен на котором вы разворачиваете; DNS files./rtc./turn.<DOMAIN> — на тот же сервер (сертификат один на все)

RAVEN_API_URL=https://raven.operator.kg/api/v1  # Базовый URL Raven (SMS/WhatsApp уведомления)
RAVEN_API_KEY=nrk_live_your-key-here      # API-ключ Raven (scope messages:send)

MEDCRM_API_KEY=your-medcrm-api-key-here  # API-ключ для интеграции с MedCRM
MEDCRM_SSO_WEB_URL=https://crm.pediatr.kg
MEDCRM_SSO_INTEGRATION_SECRET=change-me
MEDCRM_SSO_TTL_SECONDS=120

MAMADOC_API_URL=https://api.mamadoc.example  # Базовый URL MamaDoc (Аксима CRM) для истории визитов/заключений
MAMADOC_API_KEY=your-mamadoc-api-key-here    # API-ключ партнёрского доступа MamaDoc
MAMADOC_TIMEOUT=10                           # Таймаут запросов к MamaDoc, секунд
SENTRY_DSN=                              # DSN из Sentry (пустое = отключён)
TELEGRAM_BOT_TOKEN=                      # Токен бота для уведомлений
TELEGRAM_AUTH_BOT_TOKEN=                 # Токен бота для авторизации (по умолчанию берётся TELEGRAM_BOT_TOKEN)
TELEGRAM_AUTH_WEBHOOK_SECRET=            # Секрет в URL webhook для Telegram auth-бота
TELEGRAM_AUTH_BOT_USERNAME=              # Username бота без @, например my_auth_bot
TELEGRAM_AUTH_SESSION_TTL_SECONDS=300    # Время жизни сессии входа через Telegram
TELEGRAM_ADMIN_WEBHOOK_SECRET=           # Секрет в URL webhook бота уведомлений (по умолчанию TELEGRAM_AUTH_WEBHOOK_SECRET)
TELEGRAM_WEBHOOK_SECRET_TOKEN=           # secret_token из setWebhook, проверяется в заголовке (опционально)
TELEGRAM_ERROR_ALERTS_ENABLED=False      # Отправлять ошибки (ERROR+) в Telegram
TELEGRAM_ERROR_CHAT_ID=                  # Чат для ошибок (по умолчанию TELEGRAM_CHAT_ID)
TELEGRAM_ERROR_THREAD_ID=                # Топик для ошибок в супергруппе
TELEGRAM_ERROR_ENVIRONMENT=              # Метка окружения в тексте алерта (по умолчанию prod/dev)
TELEGRAM_ERROR_DEDUPE_SECONDS=300        # Не повторять одну и ту же ошибку чаще, чем раз в N секунд
TELEGRAM_ERROR_MAX_PER_MINUTE=20         # Лимит алертов в минуту на процесс

REDIS_URL=redis://redis:6379             # Redis без номера БД (cache /1, channels /2, Celery /3, Centrifugo /4, LiveKit /5)

CENTRIFUGO_API_URL=http://centrifugo:8000/api       # Внутренний HTTP API Centrifugo (пустое = публикации отключены)
CENTRIFUGO_API_KEY=change-me                        # http_api.key Centrifugo
CENTRIFUGO_TOKEN_SECRET=change-me                   # HMAC-секрет connection/subscription токенов
CENTRIFUGO_WS_URL=wss://example.com/connection/websocket  # Публичный WebSocket-адрес для клиентов (wss://<DOMAIN>/connection/websocket, nginx → centrifugo)

S3_ENDPOINT_URL=http://minio:9000                   # Внутренний адрес MinIO для backend
S3_PUBLIC_ENDPOINT_URL=https://files.example.com    # Адрес MinIO для presigned URL, доступный клиентам (https://files.<DOMAIN>, nginx → minio)
S3_ACCESS_KEY=change-me                             # Также корневой пользователь MinIO
S3_SECRET_KEY=change-me-long-secret                 # Также корневой пароль MinIO (минимум 8 символов)
S3_BUCKET=messenger                                 # Приватный бакет (создаётся контейнером minio-init)
S3_REGION=us-east-1                                 # Регион для подписи presigned URL
S3_KMS_SECRET_KEY=messenger-key:change-me-base64-32-bytes  # Ключ SSE-S3 MinIO: <имя>:<base64 от 32 случайных байт>

LIVEKIT_URL=wss://rtc.example.com                   # Публичный wss-адрес LiveKit для клиентов (wss://rtc.<DOMAIN>, nginx → livekit)
LIVEKIT_API_URL=http://host.docker.internal:7880    # Внутренний http-адрес LiveKit для backend/celery (LiveKit в сети хоста; extra_hosts в compose)
# Куда LiveKit шлёт вебхуки; в проде https://<DOMAIN>/api/messenger/livekit-webhook/ (пустое = без вебхуков).
# Комментарий не в строке значения: docker compose считает «KEY=  # текст» значением «# текст».
LIVEKIT_WEBHOOK_URL=
LIVEKIT_API_KEY=change-me                           # API-ключ LiveKit (также ключ в LIVEKIT_KEYS контейнера)
LIVEKIT_API_SECRET=change-me-long-secret            # API-секрет LiveKit (минимум 32 символа)
LIVEKIT_TURN_DOMAIN=turn.example.com                # Домен встроенного TURN (turn.<DOMAIN>); LiveKit не стартует без него

# APNs для VoIP-пушей о звонках iOS (пустые = VoIP-пуши выключены). Комментарии над строками,
# а не в них: docker compose считает «KEY=  # текст» значением «# текст».
# APNS_KEY_PATH — путь к .p8-ключу внутри контейнера; APNS_KEY_ID — Key ID ключа; APNS_TEAM_ID — Team ID
# Apple Developer; APNS_BUNDLE_ID — Bundle ID iOS-приложения (топик voip = <bundle>.voip).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=False                   # True — песочница APNs (dev-сборки)
